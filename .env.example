# Supabase Auth + Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Cloudflare Turnstile site key. The matching secret must also be enabled in
# Supabase Dashboard > Auth > Bot and Abuse Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# The Supabase Magic link or OTP template must contain {{ .Token }}.
NEXT_PUBLIC_AUTH_EMAIL_MODE=otp
SIGNUP_BONUS_HMAC_SECRET=replace_with_a_long_random_secret
SIGNUP_BONUS_IP_DAILY_LIMIT=3
AI_DAILY_COST_LIMIT_UNITS=50
AI_MAX_CONCURRENT_TASKS=4
AI_MAX_CONCURRENT_TASKS_PER_USER=1
# Set true to immediately stop all paid AI requests without redeploying code.
AI_KILL_SWITCH=false

# Self-hosted canvas images (keep this outside the git checkout in production)
CANVAS_ASSET_DIR=.local-data/canvas-assets
CANVAS_ASSET_MAX_BYTES=20971520
CANVAS_VIDEO_ASSET_MAX_BYTES=67108864
CANVAS_USER_STORAGE_MAX_BYTES=2147483648
# Keep disk writes bounded on small self-hosted servers (defaults: 2 global / 1 per user).
CANVAS_ASSET_MAX_CONCURRENT_WRITES=2
CANVAS_ASSET_MAX_CONCURRENT_WRITES_PER_USER=1
CANVAS_ASSET_MAX_QUEUED_WRITES=20
# Temporary compatibility escape hatch for old clients. Raw binary uploads are preferred.
CANVAS_ASSET_ALLOW_MULTIPART=false
CANVAS_REMOTE_ASSET_TIMEOUT_MS=45000

# Gemini / image generation
# proxy | official | auto
GEMINI_PROVIDER=proxy
GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://ai.t8star.cn/v1
GEMINI_PROXY_MODEL=nano-banana-pro
GEMINI_PROXY_STANDARD_MODEL=nano-banana
GEMINI_PROXY_STANDARD_MODEL_HD=nano-banana-hd
GEMINI_PROXY_STANDARD_MODEL_4K=gemini-3.1-flash-image-preview-4k
GEMINI_PROXY_PRO_MODEL=nano-banana-pro
GEMINI_PROXY_PRO_MODEL_2K=nano-banana-pro-2k
GEMINI_PROXY_PRO_MODEL_4K=nano-banana-pro-4k
GEMINI_PROXY_GPT_IMAGE_2_MODEL=gpt-image-2
GEMINI_PROXY_GPT_IMAGE_2_OFFICIAL_MODEL=gpt-image-2
GEMINI_PROXY_GPT_IMAGE_1_MODEL=gpt-image-1
GEMINI_PROXY_GPT_IMAGE_1_5_MODEL=gpt-image-1.5
GEMINI_PROXY_GPT_IMAGE_2_POLL_INTERVAL_MS=3000
GEMINI_PROXY_GPT_IMAGE_2_POLL_TIMEOUT_MS=300000
GEMINI_PROXY_TEXT_MODEL=gpt-4o

# Object annotation / click-to-select detection
# Available providers: vision, stub, sam
OBJECT_DETECTION_PROVIDER=vision
# Optional. Defaults to GEMINI_* settings when omitted.
OBJECT_DETECTION_API_KEY=your_object_detection_api_key
OBJECT_DETECTION_BASE_URL=https://ai.t8star.cn/v1
OBJECT_DETECTION_MODEL=gpt-4o

# Segmentation provider (used when OBJECT_DETECTION_PROVIDER=sam)
OBJECT_SEGMENTATION_ENDPOINT=https://your-segmentation-service.example.com/detect
OBJECT_SEGMENTATION_API_KEY=your_segmentation_api_key
OBJECT_SEGMENTATION_TIMEOUT_MS=20000

# Gemini-compatible (official/native-style) endpoint, e.g. https://tapi.nyc.mn
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key
GOOGLE_GEMINI_BASE_URL=
# Defaults to v1beta for custom Gemini REST endpoints; set empty only if your base URL already includes the full path.
GOOGLE_GEMINI_API_VERSION=v1beta
GOOGLE_GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview

# XAI / design suggestion
XAI_API_KEY=your_xai_api_key
XAI_BASE_URL=https://ai.t8star.cn/v1
XAI_MODEL=gpt-4o

# Video generation
VIDEO_API_KEY=your_video_api_key
VIDEO_API_BASE_URL=https://ai.t8star.cn
VIDEO_MODEL=doubao-seedance-2-0-260128
VIDEO_MODEL_STANDARD=doubao-seedance-2-0-260128
VIDEO_MODEL_FAST=doubao-seedance-2-0-fast-260128
VIDEO_REFERENCE_BUCKET=video-references
IMAGE_REFERENCE_BUCKET=video-references

# Kling action transfer (uses the same VIDEO_API_* relay by default)
MOTION_TRANSFER_API_PATH=/v2/videos/generations
MOTION_TRANSFER_STATUS_PATH=/v2/videos/generations/{taskId}
MOTION_TRANSFER_PAYLOAD_STYLE=snake
MOTION_TRANSFER_KLING_26_STD_MODEL=kling-v2.6-std-motion-control
MOTION_TRANSFER_KLING_26_PRO_MODEL=kling-v2.6-pro-motion-control
MOTION_TRANSFER_KLING_26_4K_MODEL=kling-v2.6-pro-motion-control
MOTION_TRANSFER_KLING_30_STD_MODEL=kling-v3.0-std-motion-control
MOTION_TRANSFER_KLING_30_PRO_MODEL=kling-v3.0-pro-motion-control
MOTION_TRANSFER_KLING_30_4K_MODEL=kling-v3.0-pro-motion-control

# Remove background
# Available providers: stub, runninghub
REMOVE_BG_PROVIDER=stub

# Upscale
# Available providers: stub, runninghub
UPSCALE_PROVIDER=stub

# RunningHub
RUNNINGHUB_API_HOST=https://www.runninghub.cn
RUNNINGHUB_API_KEY=your_runninghub_api_key
RUNNINGHUB_REMOVE_BG_WEBAPP_ID=2039643601201799170
RUNNINGHUB_REMOVE_BG_INPUT_NODE_ID=141
RUNNINGHUB_REMOVE_BG_INPUT_FIELD_NAME=image
RUNNINGHUB_REMOVE_BG_INSTANCE_TYPE=default
RUNNINGHUB_UPSCALE_WEBAPP_ID=1925889402541658114
RUNNINGHUB_UPSCALE_INPUT_NODE_ID=2
RUNNINGHUB_UPSCALE_INPUT_FIELD_NAME=image
RUNNINGHUB_UPSCALE_SCALE_NODE_ID=217
RUNNINGHUB_UPSCALE_SCALE_FIELD_NAME=value
RUNNINGHUB_UPSCALE_INSTANCE_TYPE=default
# Optional feature flags (enabled unless explicitly set to false)
NEXT_PUBLIC_FEATURE_AGENT_PANEL=true
NEXT_PUBLIC_FEATURE_NODE_REGISTRY_MENUS=true
